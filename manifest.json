{
  "manifest_version": 3,
  "name": "SIGA Scheduler Extension",
  "version": "1.0",
  "description": "Schedules a month's school meals on SIGA.",
  "content_scripts": [
    {
      "matches": ["https://node3.siga.edubox.pt/webapp/schedules/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
